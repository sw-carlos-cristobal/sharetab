# ─── Database ───────────────────────────────────────────────
# For local dev with embedded-postgres (npm run dev:full):
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/sharetab"
# For Docker (constructed from DB_USER/DB_PASSWORD/DB_NAME if not set):
# DATABASE_URL="postgresql://sharetab:sharetab@localhost:5432/sharetab"
DB_USER="sharetab"
DB_PASSWORD="sharetab"
DB_NAME="sharetab"

# ─── NextAuth ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST=true

# ─── Google OAuth (optional) ────────────────────────────────
# Registers the Google provider; the login page has no Google button yet (see README).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── OIDC / SSO (optional — Authentik, Authelia, Keycloak, ...) ─
# Enabled when issuer, client ID and client secret are all set.
# Redirect URI to register at your IdP: <NEXTAUTH_URL>/api/auth/callback/oidc
# OIDC_ISSUER must match the "issuer" in <issuer>/.well-known/openid-configuration
# exactly — Authentik's ends with a slash: https://auth.example.com/application/o/sharetab/
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
# Button label: "Sign in with <name>"
OIDC_DISPLAY_NAME="SSO"
# Create a ShareTab account the first time a new IdP user signs in
OIDC_AUTO_REGISTER="true"
# Link a first-time IdP login to an existing ShareTab user with the same email.
# Only enable if your IdP does not let users set arbitrary, unverified emails.
# Refused while anyone can sign up with a password (Registration Mode: Open).
OIDC_ALLOW_EMAIL_LINKING="false"
# How the client secret is sent: client_secret_basic (default) or client_secret_post
OIDC_TOKEN_AUTH_METHOD="client_secret_basic"
# Hide the email/password form and close registration. Ignored unless OIDC or
# magic link sign-in is configured. With SSO only, link existing accounts first
# (see README "Moving existing users to SSO") or their owners can't sign in.
DISABLE_PASSWORD_LOGIN="false"

# ─── AI Receipt Scanning ───────────────────────────────────
# Provider: "openai" | "openai-codex" | "claude" | "meridian" | "ollama"
# - openai: requires OPENAI_API_KEY (uses GPT-4o by default)
# - openai-codex: uses ChatGPT OAuth via the Codex backend (no API key; complete login from /admin and persist /app/chatgpt)
# - claude: requires ANTHROPIC_API_KEY
# - meridian: uses Claude Max subscription via embedded proxy (no API key; complete login from /admin and persist /app/claude)
# - ollama: local model, requires OLLAMA_BASE_URL
# Ordered provider chain (comma-separated): first available provider is used,
# and extraction errors fall through to the next provider.
AI_PROVIDER_PRIORITY="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
OPENAI_CODEX_MODEL="gpt-5.5"
ANTHROPIC_API_KEY=""
# Default model for both the claude and meridian providers: claude-sonnet-5
# This env var overrides the default for both providers.
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_HEALTH_MODEL="claude-haiku-4-5-20251001"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llava"
# Port for the embedded Meridian proxy (used when meridian is in AI_PROVIDER_PRIORITY)
MERIDIAN_PORT="3457"

# ─── Magic Link Email (optional — enables passwordless sign-in) ─
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# ─── File Uploads ───────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="10"

# ─── Rate Limiting ──────────────────────────────────────────
# NOTE: per-IP limits derive the client IP from proxy headers
# (cf-connecting-ip, then x-real-ip, then x-forwarded-for). These are spoofable
# unless a trusted reverse proxy sets them from the connection — front the
# app with one in production. Per-account and global caps apply regardless.
# Max login attempts per email per 15 minutes (increase for testing/CI)
AUTH_RATE_LIMIT_MAX="5"
# Max login attempts per client IP per 15 minutes (bounds password spraying)
AUTH_IP_RATE_LIMIT_MAX="30"
# Max registrations per IP per hour
REGISTER_RATE_LIMIT_MAX="10"
# Per IP per hour, counted separately for guest receipt uploads, guest splits,
# and claim sessions
GUEST_RATE_LIMIT_MAX="10"
# Global hourly caps across ALL guests combined — bounds unauthenticated disk
# usage and AI spend even if per-IP limits are bypassed via spoofed headers
GUEST_UPLOAD_GLOBAL_LIMIT="100"
GUEST_AI_GLOBAL_LIMIT="100"
# To stop anonymous receipt uploads and AI scans entirely, turn off
# "Guest Receipt Uploads" in the admin dashboard, or set this to "true" to lock
# them off regardless of the admin toggle. Signed-in users with an active account
# keep access, so also limit who can create one: Registration Control only covers
# password sign-up; magic link, Google and OIDC auto-registration still create accounts
DISABLE_GUEST_UPLOADS="false"

# ─── Admin ──────────────────────────────────────────────────
# Email of the admin user (grants access to /admin dashboard)
ADMIN_EMAIL=""

# ─── Logging ────────────────────────────────────────────────
# "debug" | "info" | "warn" | "error" (default: "info" in production, "debug" in dev)
LOG_LEVEL="info"
